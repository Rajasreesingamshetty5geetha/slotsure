### SlotSure V2 — end to end (IntelliJ HTTP Client)
# Run the requests top to bottom with all four services up. Response handlers store values
# (purchaseIds, slotIds, holdIds, orderIds) in client.global for the requests that follow.
# Flow: purchases -> slots -> PREPAID order -> CASH order -> ONLINE order -> deliver -> settle -> admin.

@slotHost = http://localhost:8081
@orderHost = http://localhost:8082
@paymentHost = http://localhost:8083
@dispatchHost = http://localhost:8084
# user1@slotsure.demo (CONTRACT V2.2)
@customerId = 6f1c2a10-3b7d-4e2a-9c11-0a1b2c3d4e01
@otherCustomerId = 6f1c2a10-3b7d-4e2a-9c11-0a1b2c3d4e02
# Koramangala
@lat = 12.9352
@lng = 77.6245

### 1. Purchases waiting for a slot (a new customer gets three starter purchases)
GET {{orderHost}}/api/purchases?customerId={{customerId}}
Accept: application/json

> {%
    const waiting = response.body.filter(p => p.status === "AWAITING_SLOT");
    const prepaid = waiting.find(p => p.paymentMode === "PREPAID");
    const cod = waiting.filter(p => p.paymentMode === "COD");
    client.test("one PREPAID and two COD purchases awaiting a slot", () => {
        client.assert(response.status === 200, "expected 200, got " + response.status);
        client.assert(prepaid, "no PREPAID purchase awaiting a slot (restart order-service to top up the demo user)");
        client.assert(cod.length >= 2, "need two COD purchases awaiting a slot, found " + cod.length);
    });
    client.global.set("prepaidPurchaseId", prepaid.purchaseId);
    client.global.set("cashPurchaseId", cod[0].purchaseId);
    client.global.set("onlinePurchaseId", cod[1].purchaseId);
%}

### 2. Slots for Koramangala tomorrow (every slot carries areaName)
< {%
    const d = new Date();
    d.setDate(d.getDate() + 1);
    const pad = n => (n < 10 ? "0" : "") + n;
    client.global.set("tomorrow", d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()));
%}
GET {{slotHost}}/api/slots?lat={{lat}}&lng={{lng}}&date={{tomorrow}}
Accept: application/json

> {%
    const free = response.body.filter(s => s.startHour >= 18 && s.remaining > 0);
    client.test("evening slots in Koramangala", () => {
        client.assert(response.status === 200, "expected 200, got " + response.status);
        client.assert(free.length >= 3, "need three free evening slots");
        client.assert(response.body[0].areaName === "Koramangala", "areaName is " + response.body[0].areaName);
    });
    ["prepaid", "cash", "online"].forEach((name, i) => {
        client.global.set(name + "SlotId", free[i].slotId);
        client.global.set(name + "StartHour", String(free[i].startHour));
        client.global.set(name + "EndHour", String(free[i].endHour));
    });
    client.global.set("runId", String(Date.now()));
%}

### 3. Hold a slot for the PREPAID purchase
POST {{slotHost}}/api/holds
Content-Type: application/json
Idempotency-Key: hold-prepaid-{{runId}}

{ "slotId": "{{prepaidSlotId}}", "customerId": "{{customerId}}" }

> {%
    client.test("hold created", () => client.assert(response.status === 201, "expected 201, got " + response.status));
    client.global.set("prepaidHoldId", response.body.holdId);
%}

### 4. A PREPAID purchase cannot be paid ONLINE
POST {{orderHost}}/api/orders
Content-Type: application/json
Idempotency-Key: order-invalid-{{runId}}

{
  "customerId": "{{customerId}}",
  "purchaseId": "{{prepaidPurchaseId}}",
  "holdId": "{{prepaidHoldId}}",
  "paymentChoice": "ONLINE",
  "slotDate": "{{tomorrow}}",
  "startHour": {{prepaidStartHour}},
  "endHour": {{prepaidEndHour}}
}

> {%
    client.test("400 INVALID_PAYMENT_CHOICE", () => {
        client.assert(response.status === 400, "expected 400, got " + response.status);
        client.assert(response.body.code === "INVALID_PAYMENT_CHOICE", "code is " + response.body.code);
    });
%}

### 5. Book the PREPAID purchase (no payment step; the amount comes from the purchase)
POST {{orderHost}}/api/orders
Content-Type: application/json
Idempotency-Key: order-{{prepaidHoldId}}

{
  "customerId": "{{customerId}}",
  "purchaseId": "{{prepaidPurchaseId}}",
  "holdId": "{{prepaidHoldId}}",
  "paymentChoice": "PREPAID",
  "lat": {{lat}},
  "lng": {{lng}},
  "address": "42, 5th Cross, Koramangala, Bengaluru",
  "areaName": "Koramangala",
  "slotDate": "{{tomorrow}}",
  "startHour": {{prepaidStartHour}},
  "endHour": {{prepaidEndHour}}
}

> {%
    client.test("order PENDING, PREPAID", () => {
        client.assert(response.status === 201, "expected 201, got " + response.status);
        client.assert(response.body.status === "PENDING", "status is " + response.body.status);
        client.assert(response.body.paymentChoice === "PREPAID", "paymentChoice is " + response.body.paymentChoice);
    });
    client.global.set("prepaidOrderId", response.body.orderId);
%}

### 6. A second order for the same purchase is refused
POST {{orderHost}}/api/orders
Content-Type: application/json
Idempotency-Key: order-again-{{runId}}

{
  "customerId": "{{customerId}}",
  "purchaseId": "{{prepaidPurchaseId}}",
  "holdId": "{{prepaidHoldId}}",
  "paymentChoice": "PREPAID",
  "slotDate": "{{tomorrow}}",
  "startHour": {{prepaidStartHour}},
  "endHour": {{prepaidEndHour}}
}

> {%
    client.test("409 ALREADY_SCHEDULED", () => {
        client.assert(response.status === 409, "expected 409, got " + response.status);
        client.assert(response.body.code === "ALREADY_SCHEDULED", "code is " + response.body.code);
    });
%}

### 7. Hold a slot for the first COD purchase
POST {{slotHost}}/api/holds
Content-Type: application/json
Idempotency-Key: hold-cash-{{runId}}

{ "slotId": "{{cashSlotId}}", "customerId": "{{customerId}}" }

> {% client.global.set("cashHoldId", response.body.holdId); %}

### 8. Book it to pay in cash or UPI on delivery
POST {{orderHost}}/api/orders
Content-Type: application/json
Idempotency-Key: order-{{cashHoldId}}

{
  "customerId": "{{customerId}}",
  "purchaseId": "{{cashPurchaseId}}",
  "holdId": "{{cashHoldId}}",
  "paymentChoice": "CASH",
  "lat": {{lat}},
  "lng": {{lng}},
  "address": "42, 5th Cross, Koramangala, Bengaluru",
  "areaName": "Koramangala",
  "slotDate": "{{tomorrow}}",
  "startHour": {{cashStartHour}},
  "endHour": {{cashEndHour}}
}

> {%
    client.test("order PENDING, COD paid in CASH", () => {
        client.assert(response.status === 201, "expected 201, got " + response.status);
        client.assert(response.body.paymentMode === "COD" && response.body.paymentChoice === "CASH", JSON.stringify(response.body));
    });
    client.global.set("cashOrderId", response.body.orderId);
%}

### 9. Hold a slot for the second COD purchase
POST {{slotHost}}/api/holds
Content-Type: application/json
Idempotency-Key: hold-online-{{runId}}

{ "slotId": "{{onlineSlotId}}", "customerId": "{{customerId}}" }

> {% client.global.set("onlineHoldId", response.body.holdId); %}

### 10. Book it and pay now (runs the payment saga: gateway A, B as fallback)
POST {{orderHost}}/api/orders
Content-Type: application/json
Idempotency-Key: order-{{onlineHoldId}}

{
  "customerId": "{{customerId}}",
  "purchaseId": "{{onlinePurchaseId}}",
  "holdId": "{{onlineHoldId}}",
  "paymentChoice": "ONLINE",
  "lat": {{lat}},
  "lng": {{lng}},
  "address": "42, 5th Cross, Koramangala, Bengaluru",
  "areaName": "Koramangala",
  "slotDate": "{{tomorrow}}",
  "startHour": {{onlineStartHour}},
  "endHour": {{onlineEndHour}}
}

> {%
    client.test("order PENDING, COD paid ONLINE", () => client.assert(response.status === 201, "expected 201, got " + response.status));
    client.global.set("onlineOrderId", response.body.orderId);
%}

### 11. The PREPAID order (run again after a second or two: CONFIRMED, then OUT_FOR_DELIVERY with an agent)
GET {{orderHost}}/api/orders/{{prepaidOrderId}}
Accept: application/json

> {%
    client.log("status=" + response.body.status + " sagaStep=" + response.body.sagaStep
        + " area=" + response.body.areaName + " agent=" + response.body.agentName + " " + response.body.agentPhone);
%}

### 12. The customer's orders, newest first
GET {{orderHost}}/api/orders?customerId={{customerId}}
Accept: application/json

### 13. Another customer does not see them
GET {{orderHost}}/api/orders?customerId={{otherCustomerId}}
Accept: application/json

> {%
    const mine = [client.global.get("prepaidOrderId"), client.global.get("cashOrderId"), client.global.get("onlineOrderId")];
    client.test("no orders of user1", () => client.assert(!response.body.some(o => mine.includes(o.orderId)), "user2 sees user1's orders"));
%}

### 14. No payment was taken for the CASH order
GET {{paymentHost}}/api/payments/{{cashOrderId}}
Accept: application/json

> {% client.test("404 PAYMENT_NOT_FOUND", () => client.assert(response.status === 404, "expected 404, got " + response.status)); %}

### 15. The ONLINE order was charged (gateway A or B)
GET {{paymentHost}}/api/payments/{{onlineOrderId}}
Accept: application/json

### 16. Agents and their load today
GET {{dispatchHost}}/api/agents
Accept: application/json

### 17. Mark the PREPAID order delivered
POST {{dispatchHost}}/api/deliveries/{{prepaidOrderId}}/complete
Idempotency-Key: complete-{{prepaidOrderId}}

> {%
    client.test("delivered", () => client.assert(response.status === 200, "expected 200, got " + response.status));
    client.global.set("prepaidDeliveredAt", response.body.deliveredAt);
%}

### 18. Again: the same result, nothing delivered twice
POST {{dispatchHost}}/api/deliveries/{{prepaidOrderId}}/complete
Idempotency-Key: complete-{{prepaidOrderId}}-again

> {%
    client.test("same deliveredAt", () =>
        client.assert(response.body.deliveredAt === client.global.get("prepaidDeliveredAt"), "deliveredAt changed"));
%}

### 19. Mark the CASH order delivered
POST {{dispatchHost}}/api/deliveries/{{cashOrderId}}/complete
Idempotency-Key: complete-{{cashOrderId}}

### 20. Mark the ONLINE order delivered
POST {{dispatchHost}}/api/deliveries/{{onlineOrderId}}/complete
Idempotency-Key: complete-{{onlineOrderId}}

### 21. Unknown order
POST {{dispatchHost}}/api/deliveries/00000000-0000-0000-0000-000000000000/complete
Idempotency-Key: complete-unknown

> {% client.test("404 NOT_ASSIGNED", () => client.assert(response.body.code === "NOT_ASSIGNED", "code is " + response.body.code)); %}

### 22. PREPAID settlement: checkout capture into escrow, then escrow to the merchant
GET {{paymentHost}}/api/ledger/{{prepaidOrderId}}
Accept: application/json

### 23. CASH settlement: cash collected to the merchant
GET {{paymentHost}}/api/ledger/{{cashOrderId}}
Accept: application/json

### 24. Ledger check — debits must equal credits
GET {{paymentHost}}/api/ledger/check
Accept: application/json

> {%
    client.test("ledger balanced", () => client.assert(Number(response.body.difference) === 0, "difference is " + response.body.difference));
%}

### 25. Notifications: SLOT_CONFIRMED, AGENT_ASSIGNED and DELIVERED for each order, newest first
GET {{orderHost}}/api/notifications?customerId={{customerId}}
Accept: application/json

> {%
    client.global.set("notificationId", response.body[0].id);
    client.global.set("newestNotification", response.body[0].createdAt);
%}

### 26. Only notifications after the newest one (what the app polls with)
GET {{orderHost}}/api/notifications?customerId={{customerId}}&after={{newestNotification}}
Accept: application/json

### 27. Mark one read
POST {{orderHost}}/api/notifications/{{notificationId}}/read

> {% client.test("204", () => client.assert(response.status === 204, "expected 204, got " + response.status)); %}

### 28. Admin — bookings, money and top items for today (dates are slot dates; omit date for today)
GET {{orderHost}}/api/admin/summary
Accept: application/json

### 29. Admin — today's orders, newest first
GET {{orderHost}}/api/admin/orders
Accept: application/json

### 30. Admin — slot capacity and busiest slots
GET {{slotHost}}/api/admin/slots
Accept: application/json

### 31. Admin — dispatch totals by area
GET {{dispatchHost}}/api/admin/dispatch
Accept: application/json

### 32. Admin — money movements today
GET {{paymentHost}}/api/admin/payments
Accept: application/json

> {%
    client.test("ledger difference 0", () => client.assert(Number(response.body.ledgerDifference) === 0, "difference is " + response.body.ledgerDifference));
%}
